--- admin-baseline/supabase/migrations/20260723_fix_change_requests_rls_and_justification.sql	1970-01-01 00:00:00.000000000 +0000
+++ planning-cardiomaine/supabase/migrations/20260723_fix_change_requests_rls_and_justification.sql	2026-07-24 21:04:24.272211743 +0000
@@ -0,0 +1,29 @@
+-- Corrections sur change_requests (table déjà créée par scripts/002_create_change_requests_table.sql
+-- mais jamais utilisée dans le code jusqu'ici - voir app/actions/change-request-actions.ts) :
+--
+-- 1. Ajout de `justification` (texte libre demandé par la spec métier, section 8/11).
+-- 2. Correction d'une faille RLS : la policy "Anyone can update change requests" utilisait
+--    USING (true) alors que son commentaire disait "Only admins can update" — n'importe quel
+--    utilisateur connecté pouvait valider/rejeter une demande. Corrigé pour vérifier
+--    réellement profiles.role = 'admin' (même pattern que planning_notes).
+
+ALTER TABLE public.change_requests ADD COLUMN IF NOT EXISTS justification TEXT;
+
+DROP POLICY IF EXISTS "Anyone can update change requests" ON public.change_requests;
+
+CREATE POLICY "Only admins can update change requests" ON public.change_requests
+  FOR UPDATE
+  USING (
+    EXISTS (
+      SELECT 1 FROM public.profiles
+      WHERE profiles.id = auth.uid()
+      AND profiles.role = 'admin'
+    )
+  )
+  WITH CHECK (
+    EXISTS (
+      SELECT 1 FROM public.profiles
+      WHERE profiles.id = auth.uid()
+      AND profiles.role = 'admin'
+    )
+  );
