+"use server"
+
+/**
+ * Système de demandes de changement (spec métier section 8/11) :
+ * - Seuls les admins (profiles.role = 'admin', en pratique M et Z) modifient
+ *   directement le planning.
+ * - Les autres utilisateurs sont en lecture seule mais peuvent soumettre une
+ *   demande de changement (médecin souhaité + justification libre) via
+ *   createChangeRequest().
+ * - Un admin liste les demandes en attente (getPendingChangeRequests) et les
+ *   valide ou rejette (reviewChangeRequest). Valider applique immédiatement
+ *   le changement au planning réel (via saveScheduleToDb).
+ *
+ * Table : change_requests (voir scripts/002_create_change_requests_table.sql
+ * + supabase/migrations/20260723_fix_change_requests_rls_and_justification.sql
+ * pour la correction de sécurité RLS et l'ajout du champ justification).
+ */
+
+import { createClient } from "@/lib/supabase/server"
+import { revalidatePath } from "next/cache"
+import type { CellData, ChangeRequest, ScheduleData } from "@/lib/types"
+import { getScheduleFromDb, saveScheduleToDb } from "@/app/actions/schedule-actions"
+
+async function requireAdmin(): Promise<{ userId: string; initial: string }> {
+  const supabase = await createClient()
+  const {
+    data: { user },
+  } = await supabase.auth.getUser()
+
+  if (!user) throw new Error("Non authentifié")
+
+  const { data: profile } = await supabase.from("profiles").select("role").eq("id", user.id).single()
+
+  if (!profile || profile.role !== "admin") {
+    throw new Error("Action réservée aux administrateurs")
+  }
+
+  return { userId: user.id, initial: user.email?.split("@")[0]?.toUpperCase() || "ADMIN" }
+}
+
+/**
+ * Soumet une demande de changement. Accessible à tout utilisateur connecté
+ * (pas de vérification admin ici - c'est justement le canal prévu pour les
+ * non-admins). N'écrit jamais directement dans `schedules` : reste "pending"
+ * tant qu'un admin n'a pas validé.
+ */
+export async function createChangeRequest(
+  weekKey: string,
+  rowId: string,
+  day: string,
+  requestedDoctor: string,
+  justification: string,
+  requester: string,
+): Promise<void> {
+  const supabase = await createClient()
+
+  const currentSchedule = await getScheduleFromDb(weekKey)
+  const oldValue: CellData | null =
+    (currentSchedule?.schedule_data as ScheduleData | undefined)?.[rowId]?.[day] || null
+
+  const { error } = await supabase.from("change_requests").insert({
+    week_key: weekKey,
+    row_id: rowId,
+    day,
+    requester,
+    old_value: oldValue,
+    new_value: { doctor: requestedDoctor },
+    justification: justification || null,
+    status: "pending",
+  })
+
+  if (error) {
+    console.error("[change-requests] Erreur création:", error)
+    throw new Error("Impossible d'envoyer la demande. Réessayez.")
+  }
+
+  revalidatePath("/")
+}
+
+/**
+ * Liste les demandes en attente. Réservé aux admins (vérifié explicitement,
+ * pas seulement par la RLS - défense en profondeur).
+ */
+export async function getPendingChangeRequests(): Promise<ChangeRequest[]> {
+  await requireAdmin()
+  const supabase = await createClient()
+
+  const { data, error } = await supabase
+    .from("change_requests")
+    .select("*")
+    .eq("status", "pending")
+    .order("created_at", { ascending: true })
+
+  if (error) {
+    console.error("[change-requests] Erreur lecture:", error)
+    return []
+  }
+
+  return (data || []) as ChangeRequest[]
+}
+
+/**
+ * Valide ou rejette une demande. Réservé aux admins.
+ * En cas de validation : applique IMMÉDIATEMENT le changement au planning réel
+ * (ajoute le médecin demandé à la cellule concernée, statut "validated" direct -
+ * pas de second niveau de "pending" puisque c'est déjà un admin qui valide).
+ */
+export async function reviewChangeRequest(
+  requestId: string,
+  action: "validated" | "rejected",
+): Promise<void> {
+  const { initial } = await requireAdmin()
+  const supabase = await createClient()
+
+  const { data: request, error: fetchError } = await supabase
+    .from("change_requests")
+    .select("*")
+    .eq("id", requestId)
+    .single()
+
+  if (fetchError || !request) {
+    throw new Error("Demande introuvable")
+  }
+
+  if (action === "validated") {
+    const scheduleRow = await getScheduleFromDb(request.week_key)
+    const scheduleData = (scheduleRow?.schedule_data as ScheduleData) || {}
+
+    if (!scheduleData[request.row_id]) scheduleData[request.row_id] = {}
+
+    const existing = scheduleData[request.row_id][request.day]
+    const requestedDoctor = request.new_value?.doctor
+    const currentDoctors = existing?.value || []
+
+    if (requestedDoctor && !currentDoctors.includes(requestedDoctor)) {
+      scheduleData[request.row_id][request.day] = {
+        value: [...currentDoctors, requestedDoctor],
+        type: "doctor",
+        status: "validated",
+      }
+      await saveScheduleToDb(request.week_key, scheduleData, initial)
+    }
+  }
+
+  const { error: updateError } = await supabase
+    .from("change_requests")
+    .update({
+      status: action,
+      validated_at: new Date().toISOString(),
+      validated_by: initial,
+    })
+    .eq("id", requestId)
+
+  if (updateError) {
+    console.error("[change-requests] Erreur mise à jour statut:", updateError)
+    throw new Error("Impossible de finaliser la décision")
+  }
+
+  revalidatePath("/")
+}
