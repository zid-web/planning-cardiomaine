+/**
+ * Équité CORO scopée au MOIS CALENDAIRE EN COURS uniquement (M/O/W - seuls
+ * coronarographistes internes, FV est externe et hors périmètre). Contrairement
+ * aux autres catégories (cumulées à vie), CORO se réévalue chaque mois - voir
+ * demande explicite de l'utilisateur. Convertit chaque week_key ISO en date du
+ * lundi correspondant pour filtrer sur le mois en cours.
+ */
+export async function getMonthlyCoroEquity(): Promise<Record<string, number>> {
+  try {
+    const supabase = await createClient()
+    const { data, error } = await supabase
+      .from("doctor_equity_weekly")
+      .select("doctor_id, week_key, coro_count")
+
+    if (error || !data) return {}
+
+    const now = new Date()
+    const currentYear = now.getFullYear()
+    const currentMonth = now.getMonth()
+
+    const result: Record<string, number> = {}
+    for (const row of data as { doctor_id: string; week_key: string; coro_count: number }[]) {
+      const monday = isoWeekKeyToMonday(row.week_key)
+      if (!monday) continue
+      if (monday.getFullYear() === currentYear && monday.getMonth() === currentMonth) {
+        result[row.doctor_id] = (result[row.doctor_id] || 0) + (row.coro_count || 0)
+      }
+    }
+    return result
+  } catch (err) {
+    console.warn("[equity-tracking] Erreur getMonthlyCoroEquity:", err)
+    return {}
+  }
+}
+
+/** Convertit "2026-W31" -> date du lundi de cette semaine ISO. */
+function isoWeekKeyToMonday(weekKey: string): Date | null {
+  const match = weekKey.match(/^(\d{4})-W(\d{2})$/)
+  if (!match) return null
+  const year = parseInt(match[1], 10)
+  const week = parseInt(match[2], 10)
+
+  const jan4 = new Date(Date.UTC(year, 0, 4))
+  const jan4Day = jan4.getUTCDay() || 7
+  const week1Monday = new Date(jan4)
+  week1Monday.setUTCDate(jan4.getUTCDate() - jan4Day + 1)
+
+  const targetMonday = new Date(week1Monday)
+  targetMonday.setUTCDate(week1Monday.getUTCDate() + (week - 1) * 7)
+  return targetMonday
+}
+
+/** Pondérations d'équité (temps partiel/ancienneté). Absent = 100 (plein temps). */
+export async function getEquityWeights(): Promise<Record<string, number>> {
+  try {
+    const supabase = await createClient()
+    const { data, error } = await supabase.from("doctor_equity_weights").select("doctor_id, poids_equite_pct")
+    if (error) return {}
+
+    const weights: Record<string, number> = {}
+    for (const row of data as { doctor_id: string; poids_equite_pct: number }[]) {
+      weights[row.doctor_id] = row.poids_equite_pct
+    }
+    return weights
+  } catch (err) {
+    console.warn("[equity-tracking] Erreur getEquityWeights:", err)
+    return {}
+  }
+}
