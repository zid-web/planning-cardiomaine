+-- l'équité CORO mensuelle (M/O/W uniquement) - voir lib/equity-tracking.ts
+-- (getMonthlyCoroEquity) et solver.py (points_coro).
+
+ALTER TABLE public.doctor_equity_weekly
+  ADD COLUMN IF NOT EXISTS coro_count INTEGER NOT NULL DEFAULT 0;
