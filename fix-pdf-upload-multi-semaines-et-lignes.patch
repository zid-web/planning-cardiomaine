+def pdf_pages_to_images_base64(file_bytes: bytes, dpi: int = 150) -> List[str]:
+    """Rend TOUTES les pages du PDF en images (une par semaine, cas des exports
+    multi-semaines : chaque page = un planning hebdomadaire complet)."""
+    try:
+        doc = fitz.open(stream=file_bytes, filetype="pdf")
+        images = []
+        for page in doc:
+            pix = page.get_pixmap(dpi=dpi)
+            images.append(base64.b64encode(pix.tobytes("png")).decode("utf-8"))
+        return images
+    except Exception as e:
+        raise HTTPException(status_code=422, detail=f"PDF illisible : {str(e)}")
+
