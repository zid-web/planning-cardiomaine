+def extract_planning_from_pdf(file_bytes: bytes) -> PdfExtractionResult:
+    """Cas mono-semaine (comportement historique) : ne traite que la 1ère page."""
+    image_b64 = pdf_to_image_base64(file_bytes)
+    return extract_planning_from_image(image_b64)
+
+
+async def extract_all_weeks_from_pdf(file_bytes: bytes) -> List[PdfExtractionResult]:
+    """Cas multi-semaines : une page = une semaine complète. Traite TOUTES les
+    pages EN PARALLÈLE (asyncio.to_thread, le SDK Anthropic étant synchrone) -
+    indispensable pour rester sous la limite de 60s de Vercel/Render : 9 appels
+    séquentiels dépasseraient largement cette limite, en parallèle le temps total
+    reste proche du temps d'une seule page."""
+    images = pdf_pages_to_images_base64(file_bytes)
+    if not images:
+        raise HTTPException(status_code=422, detail="PDF vide ou illisible.")
+
+    tasks = [asyncio.to_thread(extract_planning_from_image, img) for img in images]
+    return await asyncio.gather(*tasks)
+
