index 0000000..3361cfc
--- /dev/null
+++ b/lib/equity-tracking.ts
@@ -0,0 +1,172 @@
+import { createClient } from "@/lib/supabase/server"
+import type { ScheduleData } from "@/lib/types"
+
+export interface EquityCounts {
+  astreinte_count: number
+  garde_count: number
+  nct_count: number
+  weekend_count: number
+  coro_count: number
+}
+
+const ASTREINTE_ROWS = new Set(["Astreintes ATL Matin", "Astreintes ATL Midi", "Astreintes ATL Nuit"])
+const GARDE_ROWS = new Set(["Garde Matin", "Garde Midi", "Garde Nuit"])
+const NCT_ROWS = new Set(["Hors site - NCT"])
+const CORO_ROWS = new Set(["Matin - Coro", "Apm - Coro"])
+const WEEKEND_DAYS = new Set(["SAMEDI", "DIMANCHE"])
+
+function emptyCounts(): EquityCounts {
+  return { astreinte_count: 0, garde_count: 0, nct_count: 0, weekend_count: 0, coro_count: 0 }
+}
+
+/**
+ * Calcule les compteurs d'équité pour UNE semaine, à partir de son schedule_data.
+ * IMPORTANT : lit cell.value (tableau d'initiales), PAS cell.doctor/cell.activity
+ * qui n'existent pas sur le vrai type CellData - c'était le bug qui faisait
+ * retourner des compteurs vides silencieusement.
+ */
+export function computeWeeklyEquity(scheduleData: ScheduleData): Record<string, EquityCounts> {
+  const equity: Record<string, EquityCounts> = {}
+  const bump = (doc: string, key: keyof EquityCounts) => {
+    if (!equity[doc]) equity[doc] = emptyCounts()
+    equity[doc][key]++
+  }
+
+  Object.entries(scheduleData || {}).forEach(([rowKey, dayData]) => {
+    const isAstreinte = ASTREINTE_ROWS.has(rowKey)
+    const isGarde = GARDE_ROWS.has(rowKey)
+    const isNct = NCT_ROWS.has(rowKey)
+    const isCoro = CORO_ROWS.has(rowKey)
+    if (!isAstreinte && !isGarde && !isNct && !isCoro) return
+
+    Object.entries(dayData || {}).forEach(([day, cell]) => {
+      const doctors = (cell as { value?: string[] })?.value || []
+      doctors.forEach((doc) => {
+        if (isAstreinte) {
+          bump(doc, "astreinte_count")
+          if (WEEKEND_DAYS.has(day.toUpperCase())) bump(doc, "weekend_count")
+        }
+        if (isGarde) bump(doc, "garde_count")
+        if (isNct) bump(doc, "nct_count")
+        if (isCoro) bump(doc, "coro_count")
+      })
+    })
+  })
+
+  return equity
+}
+
+/** Snapshot semaine -> remplace en base (idempotent, voir doctor_equity_weekly). */
+export async function upsertWeeklyEquity(weekKey: string, scheduleData: ScheduleData): Promise<void> {
+  if (weekKey === "full_schedule") return
+  try {
+    const equity = computeWeeklyEquity(scheduleData)
+    const supabase = await createClient()
+
+    const rows = Object.entries(equity).map(([doctor_id, counts]) => ({
+      doctor_id,
+      week_key: weekKey,
+      ...counts,
+      updated_at: new Date().toISOString(),
+    }))
+
+    await supabase.from("doctor_equity_weekly").delete().eq("week_key", weekKey)
+    if (rows.length === 0) return
+
+    const { error } = await supabase.from("doctor_equity_weekly").insert(rows)
+    if (error) console.warn("[equity-tracking] Échec d'enregistrement:", error.message)
+  } catch (err) {
+    console.warn("[equity-tracking] Erreur inattendue:", err)
+  }
+}
+
+/** Équité cumulée depuis toujours (astreinte/garde/nct/weekend) - PAS coro. */
+export async function getCumulativeEquityFromTable(): Promise<Record<string, EquityCounts> | null> {
+  try {
+    const supabase = await createClient()
+    const { data, error } = await supabase
+      .from("doctor_equity_weekly")
+      .select("doctor_id, astreinte_count, garde_count, nct_count, weekend_count")
+
+    if (error) return null
+
+    const equity: Record<string, EquityCounts> = {}
+    ;(data || []).forEach((row: any) => {
+      if (!equity[row.doctor_id]) equity[row.doctor_id] = emptyCounts()
+      equity[row.doctor_id].astreinte_count += row.astreinte_count || 0
+      equity[row.doctor_id].garde_count += row.garde_count || 0
+      equity[row.doctor_id].nct_count += row.nct_count || 0
+      equity[row.doctor_id].weekend_count += row.weekend_count || 0
+    })
+    return equity
+  } catch {
+    return null
+  }
+}
+
+/**
+ * Équité CORO scopée au MOIS CALENDAIRE EN COURS uniquement (demande explicite :
+ * "l'équité s'applique le mois et non la semaine" pour M/O/W). Convertit chaque
+ * week_key ISO en date du lundi correspondant pour filtrer sur le mois en cours -
+ * plus fiable que de se fier à updated_at (qui reflète la dernière écriture, pas
+ * la semaine réelle).
+ */
+export async function getMonthlyCoroEquity(): Promise<Record<string, number>> {
+  try {
+    const supabase = await createClient()
+    const { data, error } = await supabase.from("doctor_equity_weekly").select("doctor_id, week_key, coro_count")
+
+    if (error || !data) return {}
+
+    const now = new Date()
+    const currentYear = now.getFullYear()
+    const currentMonth = now.getMonth()
+
+    const result: Record<string, number> = {}
+    for (const row of data as { doctor_id: string; week_key: string; coro_count: number }[]) {
+      const monday = isoWeekKeyToMonday(row.week_key)
+      if (!monday) continue
+      if (monday.getFullYear() === currentYear && monday.getMonth() === currentMonth) {
+        result[row.doctor_id] = (result[row.doctor_id] || 0) + (row.coro_count || 0)
+      }
+    }
+    return result
+  } catch {
+    return {}
+  }
+}
+
+/** Convertit "2026-W31" -> date du lundi de cette semaine ISO. */
+function isoWeekKeyToMonday(weekKey: string): Date | null {
+  const match = weekKey.match(/^(\d{4})-W(\d{2})$/)
+  if (!match) return null
+  const year = parseInt(match[1], 10)
+  const week = parseInt(match[2], 10)
+
+  // 4 janvier est toujours dans la semaine ISO 1
+  const jan4 = new Date(Date.UTC(year, 0, 4))
+  const jan4Day = jan4.getUTCDay() || 7 // dimanche = 0 -> 7
+  const week1Monday = new Date(jan4)
+  week1Monday.setUTCDate(jan4.getUTCDate() - jan4Day + 1)
+
+  const targetMonday = new Date(week1Monday)
+  targetMonday.setUTCDate(week1Monday.getUTCDate() + (week - 1) * 7)
+  return targetMonday
+}
+
+/** Pondérations d'équité (temps partiel/ancienneté). Absent = 100 (plein temps). */
+export async function getEquityWeights(): Promise<Record<string, number>> {
+  try {
+    const supabase = await createClient()
+    const { data, error } = await supabase.from("doctor_equity_weights").select("doctor_id, poids_equite_pct")
+    if (error) return {}
+
+    const weights: Record<string, number> = {}
+    ;(data || []).forEach((row: { doctor_id: string; poids_equite_pct: number }) => {
+      weights[row.doctor_id] = row.poids_equite_pct
+    })
+    return weights
+  } catch {
+    return {}
+  }
+}
